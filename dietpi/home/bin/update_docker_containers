#!/usr/bin/env bash
#############################################################################
set -e          # Exit on error
set -u          # Error on undefined variables
set -o pipefail # Pipe failures propagate
#############################################################################
RED="\033[1;91m"
GREEN="\033[1;92m"
YELLOW="\033[1;93m"
BLUE="\033[1;94m"
MAGENTA="\033[1;95m"
NC="\033[0m"
#############################################################################
INFO_MARK="${MAGENTA}ℹ${NC}"
ACTION_MARK="${BLUE}➜${NC}"
WARNING_MARK="${YELLOW}⚠${NC}"
SUCCESS_MARK="${GREEN}✓${NC}"
ERROR_MARK="${RED}✗${NC}"
#############################################################################
log_info() { echo -e "${INFO_MARK} ${MAGENTA}[INFO]${NC} $*"; }
log_warn() { echo -e "${WARNING_MARK} ${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${ERROR_MARK} ${RED}[ERROR]${NC} $*"; }
log_success() { echo -e "${SUCCESS_MARK} ${GREEN}[SUCCESS]${NC} $*"; }
log_action() { echo -e "${ACTION_MARK} ${BLUE}[ACTION]${NC} $*"; }
#############################################################################
[[ $EUID -eq 0 ]] && log_error "Script cannot be run by root" && exit 1
#############################################################################
function stack_is_running {
    local dir="$1"
    [ -f "${dir}docker-compose.yml" ] || return 1
    [ -n "$(cd "$dir" && docker compose ps -q --status running 2>/dev/null)" ]
}
#############################################################################
ARCH=$(uname -m)
DISTRO=$( (source /etc/os-release && echo "$ID") 2>/dev/null || echo "unknown")
DISTRO_VERSION=$( (source /etc/os-release && echo "$VERSION_ID") 2>/dev/null || echo "unknown")
#############################################################################
if grep -q "Raspberry Pi" /proc/device-tree/model 2>/dev/null ||
   [[ "$(cat /proc/device-tree/model 2>/dev/null)" == *"Raspberry"* ]] ||
   [[ -f /etc/rpi-issue ]] ||
   [[ -f /boot/issue.txt && "$(cat /proc/device-tree/model 2>/dev/null)" == *"Raspberry"* ]]; then
    DISTRO="raspberrypi"
else
    case "$DISTRO" in
        ubuntu|kubuntu|lubuntu|xubuntu) DISTRO="ubuntu" ;;
        linuxmint) DISTRO="mint" ;;
    esac
fi
#############################################################################
log_info "Distribution: $DISTRO ($DISTRO_VERSION)"
log_info "Architecture: $ARCH"
echo
case $DISTRO in
    raspberrypi|debian|ubuntu|mint)
        log_action "Updating Docker Containers..."
        update_dirs=()
        for dir in /opt/containers/*/; do
            if ! stack_is_running "$dir"; then
                log_info "Skipping $(basename "$dir") (not running)"
                continue
            fi
            case "$(basename "$dir")" in
                dnsproxy|pihole) ;;
                *) update_dirs+=("$dir") ;;
            esac
        done
        for dir in /opt/containers/dnsproxy/ /opt/containers/pihole/; do
            stack_is_running "$dir" && update_dirs+=("$dir")
        done
        if [ ${#update_dirs[@]} -eq 0 ]; then
            log_warn "No running containers to update"
        else
            for dir in "${update_dirs[@]}"; do
                name=$(basename "$dir")
                script="update_${name}.sh"
                echo "=== Updating $name ==="
                if [ -x "${dir}${script}" ]; then
                    # Use the stack's own update script
                    if grep -q -- '--yes' "${dir}${script}"; then
                        (cd "$dir" && "./${script}" --yes) || echo "!!! Failed: $name"
                    else
                        (cd "$dir" && "./${script}") || echo "!!! Failed: $name"
                    fi
                else
                    log_warn "$name has no update script, plain image swap"
                    (cd "$dir" && docker compose pull -q && docker compose down -t 30 && docker compose up -d --remove-orphans) || echo "!!! Failed: $name"
                fi
            done
            docker image prune -f
        fi
        ;;
    *)
        log_error "Unsupported distribution: $DISTRO"
        echo "Supported distributions: raspberrypi, debian, ubuntu, mint"
        exit 1
        ;;
esac
echo
log_info "Docker containers update completed!"
